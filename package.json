{
  "name": "numlab",
  "private": true,
  "version": "0.1.1",
  "description": "Numerical methods lab + CAS: step-by-step iterations, exact symbolic math, faithful plots, error analysis and Scilab export. Web & desktop, English/Spanish.",
  "license": "MIT",
  "author": "Fernando Daza (https://github.com/fernandevdaza)",
  "homepage": "https://github.com/fernandevdaza/numlab",
  "repository": {
    "type": "git",
    "url": "https://github.com/fernandevdaza/numlab.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:graficas": "node --experimental-strip-types --no-warnings scripts/fidelidad-graficas.ts",
    "test:metodos": "node --experimental-strip-types --no-warnings scripts/verificar-metodos.ts",
    "test": "pnpm test:tex && pnpm test:graficas && pnpm test:metodos",
    "desktop": "vite build && electron .",
    "desktop:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dist": "pnpm build && electron-builder --publish never",
    "capturas": "vite build && electron scripts/capturas.cjs",
    "test:tex": "node scripts/revisar-tex.cjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/katex": "^0.16.8",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "katex": "^0.18.7",
    "mathjs": "^15.2.0",
    "nerdamer": "^1.1.13",
    "plotly.js-dist-min": "^4.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "io.github.fernandevdaza.numlab",
    "productName": "NumLab",
    "copyright": "Copyright © 2026 Fernando Daza y colaboradores · MIT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "NumLab ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NumLab"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education",
      "synopsis": "Numerical methods lab + CAS",
      "maintainer": "Fernando Daza <fernandevdaza@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "fernandevdaza",
      "repo": "numlab",
      "releaseType": "draft"
    }
  }
}
